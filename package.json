    "typecheck": "tsc --noEmit",
    "build:skater": "node tools/skater/build-skater.mjs"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.2.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "three": "~0.187.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "~0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }

{
  "name": "downhill-rush",
  "private": true,
  "version": "1.0.0",
  "description": "Downhill Rush - an endless 3D downhill skateboarding game built with React Three Fiber.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
